{% comment %}
  Size Chart App Block - Free Shopify Size Chart App by Pixelotech
{% endcomment %}

<div
  class="px-size-chart-container"
  data-px-size-chart
  data-shop="{{ shop.permanent_domain }}"
  data-product-id="{{ product.id }}"
  data-product-handle="{{ product.handle }}"
  data-vendor="{{ product.vendor | escape }}"
  data-product-type="{{ product.type | escape }}"
  data-tags="{{ product.tags | join: ',' | escape }}"
  data-collections="{% for c in product.collections %}{{ c.id }}{% unless forloop.last %},{% endunless %}{% endfor %}"
  data-override-button="{{ block.settings.button_text | escape }}"
  data-override-display="{{ block.settings.display_mode_override }}"
>
  {% if request.design_mode and product == nil %}
    <div style="padding: 12px 16px; border: 1px dashed #9ca3af; border-radius: 8px; text-align: center; font-size: 13px; color: #4b5563; background: #f9fafb; margin: 8px 0;">
      📏 <strong>Size Chart:</strong> Please view this on a <strong>Product page</strong> (select <em>Products &gt; Default product</em> in the top dropdown).
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Size Chart",
  "target": "section",
  "stylesheet": "size-chart.css",
  "javascript": "size-chart.js",
  "settings": [
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Label Override",
      "info": "Leave blank to use the label configured in the app."
    },
    {
      "type": "select",
      "id": "display_mode_override",
      "label": "Display Mode Override",
      "options": [
        { "value": "default", "label": "Use App Settings" },
        { "value": "popup", "label": "Popup Modal" },
        { "value": "inline", "label": "Inline" },
        { "value": "accordion", "label": "Accordion" },
        { "value": "floating", "label": "Floating Button" }
      ],
      "default": "default"
    }
  ]
}
{% endschema %}
